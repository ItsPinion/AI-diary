# Optional — only needed for the "Fix with AI" proofreader.
# Get a key at https://aistudio.google.com/apikey
#
# Two ways to supply a key:
#   1. here, on the server (one key for everyone, never sent to a browser)
#   2. in the app: Settings → AI writing assistant → paste a key → "Test key"
#      (stored in that browser only, and takes precedence over this one)
#
# With neither, the "Fix with AI" button is not rendered at all.
GEMINI_API_KEY=

# Optional — pin a different model. Defaults to gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash
